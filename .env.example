# HTTP port (this demo uses 4401)
PORT=4401
# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# 1 = skip login and act as a fixed local user (local development only)
AUTH_DISABLED=0
# Logins allowed to edit the Register (comma-separated). Empty = every signed-in user edits.
REGISTER_EDITORS=ana.reyes,leo.marsh
# Where the BI's own database and the demo sources live
BI_DB_PATH=data/bi.db
SOURCES_PATH=data/demo/sources.json
SUPPORT_DB_PATH=data/demo/support.db
DIRECTORY_PATH=data/demo/directory.json
# Time zone used for "today", the daily snapshot and the ETL schedule
APP_TZ=America/Sao_Paulo
ETL_TIMES=06:10,12:40,17:10,20:10
